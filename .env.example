# Copy to .env and fill in. NEVER commit .env (it is gitignored).
# In Dokploy, paste these into the app's Environment settings instead of a file.

# --- RCON / console password (pick a strong random string) ---
RCON_PASSWORD=change_me_to_a_long_random_string

# --- Resources ---
MEMORY=3584M
VIEW_DISTANCE=7
SIMULATION_DISTANCE=5
MAX_PLAYERS=10
MOTD=Modded 1.20.1 SMP
TZ=America/Caracas

# --- Cloudflare R2 (S3 API) ---
# Endpoint = https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=https://e3ad2427faef6098ee545bb8b4307217.r2.cloudflarestorage.com
# Create these in Cloudflare dashboard: R2 > Manage R2 API Tokens > Create API Token (Object Read & Write)
R2_ACCESS_KEY_ID=PUT_R2_ACCESS_KEY_ID_HERE
R2_SECRET_ACCESS_KEY=PUT_R2_SECRET_ACCESS_KEY_HERE

# Where mods are stored in R2 (you upload your jars here once). Format: r2:<bucket>/<path>
MODS_REMOTE_PATH=r2:minecraftserverbackup/mods
# Where hourly world backups are written in R2. Format: <bucket>/<path>
BACKUP_DEST_DIR=minecraftserverbackup/world-backups
# Keep newest N backups on R2 (72 = ~3 days hourly)
PRUNE_BACKUPS_COUNT=72

# Set true for ONE deploy to re-pull mods from R2 over the existing volume, then set back to false.
FORCE_MOD_SYNC=false
